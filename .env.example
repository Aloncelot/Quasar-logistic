# Next.js reenvía estas rutas al compilar (ver next.config.ts). En Vercel defínelas en
# Settings → Environment Variables y vuelve a desplegar.

# Versión gratuita (Azure Container Apps). En local apunta al uvicorn de tu máquina.
AZURE_API_URL=http://127.0.0.1:8000

# Versión bajo solicitud (AWS). Si no se definen, el selector muestra AWS como no disponible.
# AWS_API_URL=http://<IP-elastica-de-EC2>
# AWS_CONTROL_URL=https://<id>.lambda-url.<region>.on.aws
